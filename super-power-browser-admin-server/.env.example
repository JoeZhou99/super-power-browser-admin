# Use the same database as super-power-browser-server.
DB_URL=jdbc:mysql://localhost:3306/super_power_browser?useUnicode=true&characterEncoding=utf8&serverTimezone=UTC
DB_USER=superpower
DB_PASSWORD=
OPS_PORT=18082
# Same 32-byte Base64 key as the business service; required when saving relay passwords.
APP_DATA_KEY=
# Optional first operator bootstrap. Existing accounts are never overwritten.
OPS_ADMIN_USERNAME=
OPS_ADMIN_PASSWORD=
# Private S3-compatible storage used for kernel ZIP packages.
KERNEL_S3_BUCKET=
KERNEL_S3_ENDPOINT=
KERNEL_S3_REGION=us-east-1
KERNEL_S3_PREFIX=kernels
KERNEL_S3_PATH_STYLE=false
KERNEL_S3_ALLOW_HTTP=false
KERNEL_URL_MINUTES=15
